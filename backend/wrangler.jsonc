{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mytask-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-03-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mytask-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
