{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mytask-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-03-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mytask-db",
      "database_id": "980253e7-3dc7-47e6-b6cc-d299b61e9875",
      "migrations_dir": "drizzle"
    }
  ],
  /*
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mytask-media"
    }
  ]
  */
}